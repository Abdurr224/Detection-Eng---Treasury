          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let apps = dynamic([\"Finastra - Prod\"]);\r\nlet x = SigninLogs\r\n| where AppDisplayName in (apps)\r\n| project UserPrincipalName;\r\nlet y = SigninLogs\r\n| where UserPrincipalName in (x)\r\n| where ResultType == \"0\"\r\n| where TimeGenerated >= ago(30d)\r\n| summarize ASN_SuccessCount = count() by UserPrincipalName, AutonomousSystemNumber;\r\nlet lookback = 30d;\r\nlet leak = SecurityAlert\r\n| where TimeGenerated >= ago(14d)\r\n| where AlertName contains \"Leaked\"\r\n| extend parse_json(tostring(Entities))\r\n| extend leaked = iff(Status != \"\",\"true\",\"N/A\")\r\n| where isnotempty(leaked)\r\n| project user = Entities[0].UserPrincipalName, TimeGenerated, leaked\r\n| distinct leaked_user = tostring(user);\r\nlet CountryCoords = datatable(CountryCode:string, DefaultLat:real, DefaultLon:real)\r\n[\r\n    \"CN\", 35.8617, 104.1954,\r\n    \"GB\", 51.5074, -0.1278,\r\n    \"US\", 37.0902, -95.7129,\r\n    \"DE\", 51.1657, 10.4515,\r\n    \"FR\", 46.2276, 2.2137,\r\n    \"IN\", 20.5937, 78.9629,\r\n    \"AU\", -25.2744, 133.7751,\r\n    \"JP\", 36.2048, 138.2529,\r\n    \"SG\", 1.3521, 103.8198,\r\n    \"HK\", 22.3193, 114.1694,\r\n    \"NL\", 52.1326, 5.2913,\r\n    \"IE\", 53.1424, -7.6921\r\n];\r\nunion SigninLogs, AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated >= ago(lookback)\r\n| where UserPrincipalName in (x)\r\n| where AppDisplayName in (apps)\r\n| extend leaked = UserPrincipalName in (leak)\r\n| extend size = substring(UserAgent,0,11)\r\n| extend AuthenticationDetails = parse_json(AuthenticationDetails) | mv-expand AuthenticationDetails\r\n| extend DeviceDetail = iff(isempty(DeviceDetail_dynamic), parse_json(DeviceDetail_string), DeviceDetail_dynamic)\r\n| extend Location = iff(isempty(LocationDetails_dynamic), parse_json(LocationDetails_string), LocationDetails_dynamic)\r\n| extend RawLatitude = toreal(Location.geoCoordinates.latitude)\r\n| extend RawLongitude = toreal(Location.geoCoordinates.longitude)\r\n| extend City = tostring(Location.city)\r\n| extend State = tostring(Location.state)\r\n| extend CountryOrRegion = tostring(Location.countryOrRegion)\r\n| join kind=leftouter CountryCoords on $left.CountryOrRegion == $right.CountryCode\r\n| extend Latitude = iff(isempty(RawLatitude), DefaultLat, RawLatitude)\r\n| extend Longitude = iff(isempty(RawLongitude), DefaultLon, RawLongitude)\r\n| extend auth = tostring(AuthenticationDetails.authenticationStepResultDetail)\r\n| extend TrustDev = iff(tostring(DeviceDetail.trustType) != \"\" , \"Managed\",\"Unmanaged\")\r\n| extend net1 = parse_json(tostring(parse_json(NetworkLocationDetails)[0].networkNames))[0]\r\n| extend net2 = parse_json(tostring(parse_json(NetworkLocationDetails)[1].networkNames))[0]\r\n| extend AuthReq = iif(AuthenticationRequirement contains \"singleFactorAuthentication\", \"SFA\", \"MFA\")\r\n| extend Result = iif(ResultType != \"0\", strcat(\"FAILURE | \", tostring(ResultType), \" | \", tostring(ResultDescription)), \"SUCCESS\")\r\n| extend ASN_IP = strcat(\"AS\", tostring(AutonomousSystemNumber), \" | \", IPAddress)\r\n| extend Device = strcat(tostring(DeviceDetail.browser),\" - \", tostring(DeviceDetail.operatingSystem),\" - \", size,\" - \", tostring(DeviceDetail.displayName))\r\n| join kind=leftouter IdentityInfo on $left.UserPrincipalName == $right.AccountUPN\r\n| join kind=leftouter (_GetWatchlist('Alpha2') | project Land = [\"Land\"], Alpha2 = [\"Alpha2\"]) on $left.Country == $right.Land\r\n| extend loc = iff(Country == Land, Alpha2, \"\")\r\n| join kind=leftouter y on UserPrincipalName, AutonomousSystemNumber\r\n| summarize Events = count() by Latitude, Longitude, City, State, CountryOrRegion, AppDisplayName, UserPrincipalName, UserLoc_IPLoc = strcat(iff(isempty(loc), \"N/A\", loc),\" -> \", tostring(CountryOrRegion)), ASN_IP, ASN_SuccessCount, Result, Device, TrustDev, NetworkLocationDetails = strcat(net1, \" - \", net2), Auth_CAP = strcat(tostring(AuthReq),\" - \", tostring(ConditionalAccessStatus)), Department_Role = strcat(tostring(JobTitle),\" - \", tostring(Department)), CredsLeaked = leaked\r\n| where isnotempty(Latitude) and isnotempty(Longitude)\r\n| sort by Events desc",
